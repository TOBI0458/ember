{
  "name": "ember",
  "version": "0.1.0",
  "description": "Ember - ein Spiele-Launcher im Steam/Epic-Stil mit automatischen Updates ueber GitHub Releases",
  "main": "electron/main.js",
  "author": "Tobias",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/make-demo.js",
    "start": "electron .",
    "demo": "node scripts/make-demo.js",
    "publish-game": "node scripts/publish-game.js",
    "icon": "node scripts/make-icon.js",
    "predist": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "release": "node scripts/release-launcher.js"
  },
  "ember": {
    "catalogUrl": "https://raw.githubusercontent.com/TOBI0458/launcher-katalog/main/games.json",
    "gamesRepo": "launcher-katalog"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tobias.ember",
    "productName": "Ember",
    "files": [
      "electron/**/*",
      "src/**/*",
      "demo/games.json",
      "package.json"
    ],
    "artifactName": "Ember-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ember"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TOBI0458",
        "repo": "ember"
      }
    ]
  }
}
